+global.GM_getValue = (k,d) => k in mem ? mem[k] : d;
+global.GM_setValue = (k,v) => { mem[k] = v; };
+global.GM_xmlhttpRequest = () => {};
+function stub() { const e = {style:{},dataset:{},options:[]}; e.querySelector=()=>stub(); e.querySelectorAll=()=>[]; e.addEventListener=()=>{}; e.appendChild=()=>{}; e.setAttribute=()=>{}; e.getAttribute=()=>null; e.closest=()=>null; e.click=()=>{}; e.focus=()=>{}; e.remove=()=>{}; e.dispatchEvent=()=>true; return e; }
+global.document={getElementById:()=>null,querySelector:()=>stub(),querySelectorAll:()=>[],createElement:()=>stub(),body:stub(),documentElement:stub(),addEventListener:()=>{},execCommand:()=>true};
+global.window=global; global.location={pathname:'/home',href:'https://x.com/home',assign:()=>{}};global.MutationObserver=class{observe(){} disconnect(){}};global.confirm=()=>false;global.prompt=()=>null;global.InputEvent=class{};global.Event=class{};
+const mod={exports:{}};new Function('module','exports',source)(mod,mod.exports);
+// A valid photo post whose own ordinary text mentions an unavailable post.
+// Text alone must not make the parent post a confirmed dead tombstone.
+const article={innerText:'This post is unavailable as an example; here is a photo.',querySelector:s=>s.includes('tweetPhoto') ? {} : null};
+assert.equal(mod.exports.isTombstone(article),false,'authored text plus a visible photo is not proof the parent is dead');
+console.log('PASS: authored text is not classified as a dead post');
+
+const {isTombstone, collectFromView, CONFIG} = mod.exports;
+function post(id, text, kind) {
+ const anchor = {getAttribute:()=>`/synthetic/status/${id}`};
+ return {innerText:text, querySelector:s=>s==='time'?{closest:()=>anchor}:(s===CONFIG.selectors.tweetPhoto && kind==='photo') || (s===CONFIG.selectors.videoPlayer && kind==='video') ? {}:null, querySelectorAll:()=>[]};
+}
+const items=[post('111','This post was deleted, but here is my photo','photo'), post('222','Quoted: This post is unavailable','video'), post('333','This post was deleted','none'), post('444','ordinary text','none')];
+for (const item of items) assert.equal(isTombstone(item),false,'article text cannot establish parent deletion');
+document.querySelectorAll=s=>s===CONFIG.selectors.article?items:[];
+CONFIG.harvestPhotos=true;
+const out=[], stats={domArticles:0,scanned:0,noId:0,tombstone:0,noMedia:0,photoSkip:0,resolved:0,queued:0,alreadyHad:0,cap:Infinity};
+collectFromView('bookmarks',new Set(),out,stats);
+assert.deepEqual(out.map(x=>x.id),['111','222'],'matching media survives; no-media posts remain excluded');
+assert.equal(stats.tombstone,0); assert.equal(stats.noMedia,2);
+CONFIG.harvestPhotos=false;
+const out2=[], stats2={domArticles:0,scanned:0,noId:0,tombstone:0,noMedia:0,photoSkip:0,resolved:0,queued:0,alreadyHad:0,cap:Infinity};
+collectFromView('bookmarks',new Set(),out2,stats2);
+assert.deepEqual(out2.map(x=>x.id),['222']); assert.equal(stats2.photoSkip,1); assert.equal(stats2.noMedia,2);
